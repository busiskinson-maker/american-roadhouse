# Public Supabase settings (Project Settings > API). The anon/publishable key is
# designed to be public; Row Level Security is what protects the data.
# NEVER put the service_role key in this file or anywhere in the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
